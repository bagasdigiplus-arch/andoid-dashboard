// src/components/DeviceModal.js
import React from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import { X, Camera, Battery, Maximize, Cpu, HardDrive } from 'lucide-react';

export default function DeviceModal({ device, isOpen, onClose }) {
  if (!isOpen || !device) return null;

  return (
    <AnimatePresence>
      <div className="fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6">
        <motion.div
          initial={{ opacity: 0 }}
          animate={{ opacity: 1 }}
          exit={{ opacity: 0 }}
          onClick={onClose}
          className="absolute inset-0 bg-black/60 backdrop-blur-sm"
        />
        
        <motion.div
          initial={{ opacity: 0, scale: 0.95, y: 20 }}
          animate={{ opacity: 1, scale: 1, y: 0 }}
          exit={{ opacity: 0, scale: 0.95, y: 20 }}
          className="relative w-full max-w-2xl bg-white dark:bg-gray-900 rounded-3xl shadow-2xl overflow-hidden z-10"
        >
          <button 
            onClick={onClose}
            className="absolute top-4 right-4 p-2 bg-gray-100 dark:bg-gray-800 rounded-full hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors z-20"
          >
            <X size={20} className="text-gray-800 dark:text-gray-200" />
          </button>

          <div className="flex flex-col md:flex-row h-full">
            <div className="w-full md:w-2/5 bg-gray-50 dark:bg-gray-800 p-8 flex items-center justify-center border-b md:border-b-0 md:border-r border-gray-200 dark:border-gray-700">
              <img 
                src={device.image_url || '/placeholder.png'} 
                alt={device.model}
                className="w-full h-auto max-h-64 object-contain drop-shadow-xl"
              />
            </div>
            
            <div className="w-full md:w-3/5 p-6 md:p-8 overflow-y-auto">
              <span className="text-sm font-bold text-blue-600 dark:text-blue-400 uppercase tracking-widest">{device.brand}</span>
              <h2 className="text-3xl font-black text-gray-900 dark:text-white mt-1 mb-6">{device.model}</h2>
              
              <div className="grid grid-cols-2 gap-4">
                <SpecItem icon={<Maximize/>} label="Screen" value={device.screen_size} />
                <SpecItem icon={<Cpu/>} label="Chipset" value={device.chipset} />
                <SpecItem icon={<HardDrive/>} label="RAM / ROM" value={device.ram_rom} />
                <SpecItem icon={<Camera/>} label="Camera" value={device.camera} />
                <SpecItem icon={<Battery/>} label="Battery" value={device.battery} />
              </div>

              <div className="mt-8 pt-6 border-t border-gray-100 dark:border-gray-800 flex justify-between items-center">
                <p className="text-sm text-gray-500 dark:text-gray-400">Harga Perkiraan</p>
                <p className="text-2xl font-bold text-gray-900 dark:text-white">{device.price}</p>
              </div>
            </div>
          </div>
        </motion.div>
      </div>
    </AnimatePresence>
  );
}

function SpecItem({ icon, label, value }) {
  return (
    <div className="flex flex-col bg-gray-50 dark:bg-gray-800/50 p-3 rounded-xl">
      <div className="flex items-center text-gray-500 dark:text-gray-400 mb-1">
        {React.cloneElement(icon, { size: 16, className: 'mr-2' })}
        <span className="text-xs font-semibold uppercase">{label}</span>
      </div>
      <span className="text-sm font-medium text-gray-900 dark:text-gray-200">{value || '-'}</span>
    </div>
  );
}

// src/utils/fetchData.js
import Papa from 'papaparse';

const SHEET_ID = '1ZI_H6nuuGYXmDvq9Tp2XUbYeWIIK66hwnZK9tSzB89k';
const GID = '1972237477';
const CSV_URL = `https://docs.google.com/spreadsheets/d/${SHEET_ID}/pub?gid=${GID}&single=true&output=csv`;

export const fetchDevices = async () => {
  try {
    const response = await fetch(CSV_URL);
    if (!response.ok) {
      throw new Error(`Gagal mengambil data: ${response.statusText}`);
    }
    const csvText = await response.text();
    
    return new Promise((resolve, reject) => {
      Papa.parse(csvText, {
        header: true,
        skipEmptyLines: true,
        complete: (results) => {
          resolve(results.data);
        },
        error: (error) => {
          reject(error);
        }
      });
    });
  } catch (error) {
    console.error("Error fetching data:", error);
    return [];
  }
};
